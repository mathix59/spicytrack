{
  "name": "spicytrack",
  "private": true,
  "version": "1.0.2",
  "license": "FSL-1.1-Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "changeset:pre:enter:alpha": "changeset pre enter alpha",
    "changeset:pre:enter:beta": "changeset pre enter beta",
    "changeset:pre:enter:rc": "changeset pre enter rc",
    "changeset:pre:exit": "changeset pre exit",
    "dev": "pnpm -r --parallel dev",
    "docker:dev": "docker compose -f docker-compose.base.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.base.yml -f docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose -f docker-compose.base.yml -f docker-compose.dev.yml down -v",
    "docker:prod": "docker compose up --build",
    "docker:prod:down": "docker compose down",
    "api:sync-client": "node scripts/sync-api-client.mjs",
    "build:local": "node scripts/run-checks.mjs build",
    "typecheck": "node scripts/run-checks.mjs typecheck",
    "lint": "pnpm -r lint",
    "lint:local": "node scripts/run-checks.mjs lint:fast",
    "lint:fast": "pnpm --filter api lint:fast && pnpm --filter web lint",
    "format": "pnpm --filter api format && pnpm --filter web format",
    "format:check:local": "node scripts/run-checks.mjs format:check",
    "format:check": "pnpm --filter api format:check && pnpm --filter web format:check",
    "test": "pnpm -r test",
    "test:e2e": "node scripts/run-e2e-stack.mjs",
    "test:e2e:k3s": "bash scripts/k3s-e2e.sh",
    "test:e2e:web": "playwright test",
    "test:api:local": "node scripts/run-checks.mjs test:api",
    "test:api:e2e:local": "node scripts/run-checks.mjs test:api:e2e",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "admin:reset-super-admins": "pnpm --filter api admin:reset-super-admins",
    "admin:grant-super-admin": "pnpm --filter api admin:grant-super-admin",
    "seed": "pnpm --filter api seed",
    "release:tag": "node scripts/create-release-tag.mjs",
    "release:tag:push": "node scripts/create-release-tag.mjs --push",
    "smoke:preprod": "node scripts/preproduction-smoke.mjs",
    "pilot:preprod": "node scripts/preproduction-pilot.mjs",
    "backup:compose": "node scripts/backup-compose.mjs",
    "restore:rehearse": "node scripts/rehearse-compose-restore.mjs",
    "load:ingest": "node scripts/load-ingest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1"
  }
}
