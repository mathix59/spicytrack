{
  "name": "api",
  "version": "1.2.0-beta.1",
  "description": "SpicyTrack API",
  "author": "",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "scripts": {
    "build": "nest build",
    "openapi:generate": "./node_modules/.bin/nest build && node scripts/generate-openapi.mjs",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "start:ingest": "nest start --entryFile main-ingest",
    "start:worker-admin": "nest start --entryFile main-worker-admin",
    "dev:ingest": "nest start --watch --entryFile main-ingest",
    "dev:worker-admin": "nest start --watch --entryFile main-worker-admin",
    "start:prod:ingest": "node dist/src/main-ingest.js",
    "start:prod:worker-admin": "node dist/src/main-worker-admin.js",
    "lint": "oxlint --type-aware --jest-plugin src test",
    "lint:fast": "oxlint src test",
    "lint:type": "oxlint --type-aware --jest-plugin src test",
    "format": "oxfmt src test scripts",
    "format:check": "oxfmt --check src test scripts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:reset-super-admins": "node scripts/manage-super-admin.mjs reset",
    "admin:grant-super-admin": "node scripts/manage-super-admin.mjs grant",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/openai": "^4.0.106",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "ai": "^7.0.159",
    "better-auth": "^1.7.14",
    "class-transformer": "^0.5.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "class-validator": "^0.15.1",
    "jest": "^30.5.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
