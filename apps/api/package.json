{
  "name": "api",
  "version": "1.1.0",
  "description": "SpicyTrack API",
  "author": "",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "scripts": {
    "build": "nest build",
    "openapi:generate": "./node_modules/.bin/nest build && node scripts/generate-openapi.mjs",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "start:ingest": "nest start --entryFile main-ingest",
    "start:worker-admin": "nest start --entryFile main-worker-admin",
    "dev:ingest": "nest start --watch --entryFile main-ingest",
    "dev:worker-admin": "nest start --watch --entryFile main-worker-admin",
    "start:prod:ingest": "node dist/src/main-ingest.js",
    "start:prod:worker-admin": "node dist/src/main-worker-admin.js",
    "lint": "oxlint --type-aware --jest-plugin src test",
    "lint:fast": "oxlint src test",
    "lint:type": "oxlint --type-aware --jest-plugin src test",
    "format": "oxfmt src test scripts",
    "format:check": "oxfmt --check src test scripts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:reset-super-admins": "node scripts/manage-super-admin.mjs reset",
    "admin:grant-super-admin": "node scripts/manage-super-admin.mjs grant",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "ai": "^7.0.58",
    "better-auth": "^1.6.26",
    "class-transformer": "^0.5.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "class-validator": "^0.15.1",
    "jest": "^30.4.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
