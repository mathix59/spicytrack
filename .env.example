DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spicytrack
# Optional: SELECT queries use this replica; writes and transactions stay on DATABASE_URL.
DATABASE_READ_REPLICA_URL=
PORT=3000
WEB_PORT=5173
PUBLIC_BASE_URL=http://localhost:3000
# Public browser origin used by GitHub App Manifest callbacks, setup redirects, and webhooks.
APP_URL=http://localhost:5173
# Optional: public endpoint serving /api/:projectId/envelope/. Defaults to PUBLIC_BASE_URL.
INGEST_BASE_URL=
INGEST_MAX_EVENT_BYTES=1000000
ARTIFACT_MAX_UPLOAD_BYTES=20971520
# Positive production defaults. Zero explicitly disables the corresponding hourly quota.
INGEST_PROJECT_EVENTS_PER_HOUR=10000
INGEST_ORGANIZATION_EVENTS_PER_HOUR=50000
WEB_BASE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000/api/better-auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Optional global Generic OAuth / OpenID Connect login.
AUTH_PASSWORD_ENABLED=true
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=company-sso
OIDC_PROVIDER_NAME=Company SSO
OIDC_ACCESS_MODE=invited
# Deprecated compatibility option: true maps to "existing", false maps to "open".
# OIDC_DISABLE_SIGN_UP=
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Link the configured OIDC identity to an existing verified account with the same email.
OIDC_ACCOUNT_LINKING_ENABLED=true
# Optional automatic membership for open/existing modes. Both values are required together.
OIDC_AUTO_JOIN_ORGANIZATION_SLUG=
OIDC_AUTO_JOIN_EMAIL_DOMAINS=
# Session rotation and authentication rate limiting.
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=100
AUTH_SIGN_IN_RATE_LIMIT_MAX=10
# Keep false on public/cloud instances. Set true only when alert webhooks must reach private hosts.
ALLOW_PRIVATE_WEBHOOK_URLS=false
# Comma-separated allowlist for trusted GitHub/GitLab Enterprise hosts.
VCS_ALLOWED_HOSTS=
# Keep false except for isolated development networks.
VCS_ALLOW_INSECURE_HTTP=false
VITE_API_BASE_URL=http://localhost:3000/api
COMPOSE_WEB_PORT=8080
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=spicytrack
STORAGE_SECRET_ACCESS_KEY=spicytrack-secret
STORAGE_BUCKET=spicytrack-artifacts
STORAGE_FORCE_PATH_STYLE=true

# Autofix / integrations
SECRETS_ENCRYPTION_KEY=
AUTOFIX_WORKDIR=/tmp/spicytrack-autofix
CODEBASE_MEMORY_MCP_BIN=codebase-memory-mcp
AUTOFIX_JOB_TIMEOUT_MS=900000
