# Required. Use the exact HTTPS URL configured on the PaaS web service, without a trailing slash.
APP_URL=https://errors.example.com

# Enable the bundled PostgreSQL and RustFS services. Remove either profile when that service is external.
COMPOSE_PROFILES=postgres,storage

# Required secrets. Generate fresh values; do not reuse these examples.
# openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-value
# openssl rand -hex 32
STORAGE_SECRET_ACCESS_KEY=replace-with-a-random-hex-value
# openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-hex-value
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-a-random-base64-value

# Pin a published release for reproducible production deployments.
VERSION=1.0.0

# Optional image registry prefix and storage settings.
IMAGE_REPOSITORY_PREFIX=ghcr.io/mathix59/spicytrack
POSTGRES_DB=spicytrack
POSTGRES_USER=spicytrack
STORAGE_ACCESS_KEY_ID=spicytrack
STORAGE_BUCKET=spicytrack-artifacts
STORAGE_REGION=us-east-1
STORAGE_IMAGE=rustfs/rustfs:latest
STORAGE_PLATFORM=linux/amd64
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_FORCE_PATH_STYLE=true

# To use an existing PostgreSQL service, set its complete connection URL and disable the bundled
# profile. URL-encode reserved characters in the credentials.
# DATABASE_URL=postgresql://user:password@postgres.example.internal:5432/spicytrack?sslmode=require
# DATABASE_READ_REPLICA_URL=postgresql://user:password@replica.example.internal:5432/spicytrack?sslmode=require

# Authentication defaults to password login. Generic OAuth/OIDC is optional and invitation-gated.
AUTH_PASSWORD_ENABLED=true
# Keep false for Internet-facing instances. Enable only for trusted internal webhook destinations.
ALLOW_PRIVATE_WEBHOOK_URLS=false
VCS_ALLOWED_HOSTS=
VCS_ALLOW_INSECURE_HTTP=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=company-sso
OIDC_PROVIDER_NAME=Company SSO
OIDC_ACCESS_MODE=invited
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_AUTO_JOIN_ORGANIZATION_SLUG=
OIDC_AUTO_JOIN_EMAIL_DOMAINS=

# Optional separate public ingestion URL. Leave empty to reuse APP_URL.
INGEST_BASE_URL=
INGEST_MAX_EVENT_BYTES=1000000
ARTIFACT_MAX_UPLOAD_BYTES=20971520
INGEST_PROJECT_EVENTS_PER_HOUR=10000
INGEST_ORGANIZATION_EVENTS_PER_HOUR=50000
